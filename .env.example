# WeatherPulse Environment Variables Example

# Primary Weather API: Uses free Open-Meteo out of the box (No API Key needed)
# If you wish to use OpenWeatherMap as secondary provider:
VITE_OPENWEATHER_API_KEY=your_openweather_key_here

# Optional WeatherMap Tile API Key (e.g. OpenWeatherMap tiles or Mapbox)
VITE_WEATHER_MAP_KEY=your_map_key_here

# Optional Custom Proxy Server URL (if using a backend proxy)
VITE_API_PROXY_URL=https://your-backend-proxy.example.com
